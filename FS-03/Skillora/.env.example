# Copy this file to .env for local development.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/skillora
REDIS_URL=redis://127.0.0.1:6379

# Development-only values. Replace both before deploying anywhere.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please

# Optional: set this before running `npm run seed` to choose demo account passwords.
SKILLORA_DEMO_PASSWORD=SkilloraDev123!
